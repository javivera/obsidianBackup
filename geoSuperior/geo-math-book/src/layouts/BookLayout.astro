---
import "katex/dist/katex.min.css";
import "../styles/global.css";
import { chapters } from "../data/chapters";
import SearchDialog from "../components/SearchDialog.astro";
import { withBase } from "../lib/paths";

type Props = {
  title: string;
  description?: string;
  chapter?: string;
  frontmatter?: {
    title?: string;
    description?: string;
    chapter?: string;
  };
};

const frontmatter = Astro.props.frontmatter ?? {};
const title = Astro.props.title ?? frontmatter.title ?? "Geo Superior";
const description = Astro.props.description ?? frontmatter.description;
const chapter = Astro.props.chapter ?? frontmatter.chapter;
const theoryChapters = chapters.filter((item) => item.section === "theory");
const practiceChapters = chapters.filter((item) => item.section === "practice");
const referenceChapters = chapters.filter((item) => item.section === "reference");
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description ?? "Libro interactivo de geometria superior"} />
    <meta name="theme-color" content="#101010" />
    <title>{title} | Geo Superior</title>
    <script is:inline>
      (() => {
        const savedTheme = localStorage.getItem("geoSuperior.theme");
        const theme = savedTheme === "light" || savedTheme === "dark"
          ? savedTheme
          : window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
        const savedFontScale = localStorage.getItem("geoSuperior.fontScale");
        const fontScale = ["normal", "large", "larger", "largest"].includes(savedFontScale)
          ? savedFontScale
          : "normal";
        document.documentElement.dataset.theme = theme;
        document.documentElement.dataset.fontScale = fontScale;
      })();
    </script>
  </head>
  <body>
    <script is:inline>
      (() => {
        let previousTap = null;
        document.addEventListener("touchend", (event) => {
          if (event.changedTouches.length !== 1) {
            previousTap = null;
            return;
          }

          const touch = event.changedTouches[0];
          const tap = { time: Date.now(), x: touch.clientX, y: touch.clientY };
          const isDoubleTap = previousTap
            && tap.time - previousTap.time < 350
            && Math.hypot(tap.x - previousTap.x, tap.y - previousTap.y) < 32;

          if (isDoubleTap) {
            event.preventDefault();
            previousTap = null;
          } else {
            previousTap = tap;
          }
        }, { passive: false });
      })();
    </script>
    <div class="book-shell">
      <aside class="sidebar" aria-label="Capitulos">
        <div class="sidebar-header">
          <a class="brand" href={withBase("/")}>
            <span>Geo Superior</span>
            <small>Libro interactivo</small>
          </a>
          <div class="sidebar-actions">
            <button class="font-toggle font-decrease" type="button" aria-label="Reducir tamano de letra">
              <span aria-hidden="true">A-</span>
              <small>100%</small>
            </button>
            <button class="font-toggle font-increase" type="button" aria-label="Aumentar tamano de letra">
              <span aria-hidden="true">A+</span>
              <small>100%</small>
            </button>
            <button class="theme-toggle" type="button" aria-label="Activar modo oscuro">
              <span aria-hidden="true">Tema</span>
              <small>Claro</small>
            </button>
            <button class="sidebar-toggle" type="button" aria-label="Ocultar panel lateral" aria-expanded="true">
              <span aria-hidden="true">‹</span>
            </button>
          </div>
        </div>
        <nav>
          <button
            class={chapter === "Buscar" ? "active utility-nav-link" : "utility-nav-link"}
            id="search-dialog-open"
            type="button"
          >
            <span>Buscar</span>
            <small>Teoremas y definiciones</small>
          </button>
          <a class={chapter === "Aleatorio" ? "active random-nav-link" : "random-nav-link"} href={withBase("/random")}>
            <span>Repaso aleatorio</span>
            <small>Definiciones y teoremas al azar</small>
          </a>
          <a class={chapter === "Corazon" ? "active random-nav-link" : "random-nav-link"} href={withBase("/corazon")}>
            <span>Corazon</span>
            <small>Evaluador de teoremas corazon</small>
          </a>
          <a class={chapter === "Corazones" ? "active random-nav-link" : "random-nav-link"} href={withBase("/corazones")}>
            <span>Teoremas corazon</span>
            <small>Enunciados y guias breves</small>
          </a>
          <a class={chapter === "Definiciones" ? "active random-nav-link" : "random-nav-link"} href={withBase("/definiciones")}>
            <span>Definiciones</span>
            <small>Todas las definiciones y sus fuentes</small>
          </a>
          <a class={chapter === "Tester" ? "active random-nav-link" : "random-nav-link"} href={withBase("/tester")}>
            <span>Tester aleatorio</span>
            <small>Examenes y puntuaciones</small>
          </a>
          <a class={chapter === "Enunciados" ? "active random-nav-link" : "random-nav-link"} href={withBase("/statements")}>
            <span>Enunciados</span>
            <small>Indice y edicion del tester</small>
          </a>
          <section class="nav-collapsible" data-nav-section="theory">
            <button
              class="nav-section-toggle"
              type="button"
              aria-expanded="true"
              aria-controls="nav-theory-links"
            >
              <span>Teoria</span>
              <span class="nav-section-chevron" aria-hidden="true">⌄</span>
            </button>
            <div class="nav-section-links" id="nav-theory-links">
              {theoryChapters.map((item) => (
                <a class={chapter === item.label ? "active" : ""} href={item.href}>
                  <span>{item.label}</span>
                  <small>{item.title}</small>
                </a>
              ))}
            </div>
          </section>
          <section class="nav-collapsible" data-nav-section="practice">
            <button
              class="nav-section-toggle"
              type="button"
              aria-expanded="true"
              aria-controls="nav-practice-links"
            >
              <span>Practica</span>
              <span class="nav-section-chevron" aria-hidden="true">⌄</span>
            </button>
            <div class="nav-section-links" id="nav-practice-links">
              {practiceChapters.map((item) => (
                <a class={chapter === item.label ? "active" : ""} href={item.href}>
                  <span>{item.label}</span>
                  <small>{item.title}</small>
                </a>
              ))}
            </div>
          </section>
          <span class="nav-section-label">Referencia</span>
          {referenceChapters.map((item) => (
            <a class={chapter === item.label ? "active" : ""} href={item.href}>
              <span>{item.label}</span>
              <small>{item.title}</small>
            </a>
          ))}
        </nav>
      </aside>
      <main>
        {chapter && <div class="current-note" aria-label={`Nota actual: ${chapter}`}>{chapter}</div>}
        <button class="sidebar-restore" type="button" aria-label="Mostrar panel lateral" hidden>
          <span aria-hidden="true">›</span>
        </button>
        <article class="book-page">
          <slot />
        </article>
      </main>
    </div>
    <SearchDialog />
    <script is:inline>
      (() => {
        if ("serviceWorker" in navigator) {
          navigator.serviceWorker.getRegistrations()
            .then((registrations) => Promise.all(registrations.map((registration) => registration.unregister())))
            .catch(() => {});
        }

        if ("caches" in window) {
          caches.keys()
            .then((names) => Promise.all(
              names
                .filter((name) => name.startsWith("geo-superior-"))
                .map((name) => caches.delete(name))
            ))
            .catch(() => {});
        }
      })();
    </script>
    <script>
      // @ts-nocheck
      const previewCache = new Map();

      function previewTargetFromDocument(doc, hash) {
        if (hash) {
          const anchor = doc.getElementById(decodeURIComponent(hash.slice(1)));
          if (anchor?.classList?.contains("book-block")) return anchor;

          const parentBlock = anchor?.closest?.(".book-block");
          if (parentBlock) return parentBlock;

          let previous = anchor?.previousElementSibling;
          while (previous) {
            if (previous.classList.contains("book-block")) return previous;
            previous = previous.previousElementSibling;
          }

          let next = anchor?.nextElementSibling;
          while (next) {
            if (next.classList.contains("book-block")) return next;
            next = next.nextElementSibling;
          }

          const target = anchor;
          if (target) return target;
        }

        return doc.querySelector(".book-page h1, .book-block");
      }

      function cleanPreviewClone(clone) {
        clone.querySelectorAll(".preview-card").forEach((node) => node.remove());
        clone.querySelectorAll(".preview-link-wrap").forEach((wrap) => {
          const link = wrap.querySelector("a");
          if (link) {
            wrap.replaceWith(link);
          }
        });
      }

      async function loadPreview(anchor) {
        const url = new URL(anchor.href, window.location.href);
        const key = url.pathname + url.hash;
        if (previewCache.has(key)) return previewCache.get(key);

        const doc = url.pathname === window.location.pathname
          ? document
          : new DOMParser().parseFromString(await fetch(url.pathname).then((res) => res.text()), "text/html");

        const target = previewTargetFromDocument(doc, url.hash);
        const clone = target?.cloneNode(true);
        if (clone instanceof Element) cleanPreviewClone(clone);

        const html = clone?.outerHTML ?? "No se encontro la referencia.";
        previewCache.set(key, html);
        return html;
      }

      function setupPreviewWrap(wrap) {
        if (wrap.dataset.previewInitialized === "true") return;

        const anchor = wrap.querySelector("a");
        const content = wrap.querySelector(".preview-content");
        if (!anchor || !content) return;
        wrap.dataset.previewInitialized = "true";

        const show = async () => {
          if (wrap.dataset.previewLoaded === "true") {
            wrap.classList.add("is-preview-ready");
            return;
          }

          content.innerHTML = "Cargando referencia...";
          content.innerHTML = await loadPreview(anchor);
          wrap.dataset.previewLoaded = "true";
          wrap.classList.add("is-preview-ready");
        };

        wrap.addEventListener("pointerenter", show);
        anchor.addEventListener("focus", show);
      }

      document.querySelectorAll(".preview-link-wrap").forEach(setupPreviewWrap);
      document.addEventListener("pointerover", (event) => {
        const wrap = event.target?.closest?.(".preview-link-wrap");
        if (!wrap) return;
        setupPreviewWrap(wrap);
        wrap.dispatchEvent(new PointerEvent("pointerenter", { bubbles: false }));
      });
      document.addEventListener("focusin", (event) => {
        const wrap = event.target?.closest?.(".preview-link-wrap");
        if (wrap) setupPreviewWrap(wrap);
      });

      function scrollToHashTarget() {
        const blockParameter = new URLSearchParams(window.location.search).get("block");
        const requestedBlock = blockParameter === null ? -1 : Number(blockParameter);
        if (Number.isInteger(requestedBlock) && requestedBlock >= 0) {
          const block = document.querySelectorAll(".book-page .book-block")[requestedBlock];
          if (block) {
            block.classList.add("search-target");
            const top = block.getBoundingClientRect().top + window.scrollY - 90;
            window.scrollTo({ top: Math.max(0, top), behavior: "auto" });
            return;
          }
        }

        if (!window.location.hash) return;

        const id = decodeURIComponent(window.location.hash.slice(1));
        const anchor = document.getElementById(id);
        if (!anchor) return;

        const target = anchor.classList.contains("book-block")
          ? anchor
          : anchor.previousElementSibling?.classList?.contains("book-block")
            ? anchor.previousElementSibling
            : anchor.nextElementSibling ?? anchor;

        const offset = 180;
        const top = target.getBoundingClientRect().top + window.scrollY - offset;
        window.scrollTo({ top: Math.max(0, top), behavior: "auto" });
      }

      window.addEventListener("hashchange", scrollToHashTarget);
      window.addEventListener("load", scrollToHashTarget);
      window.requestAnimationFrame(scrollToHashTarget);
      window.setTimeout(scrollToHashTarget, 80);
      window.setTimeout(scrollToHashTarget, 220);
      window.setTimeout(scrollToHashTarget, 500);

      const shell = document.querySelector(".book-shell");
      const hideSidebarButton = document.querySelector(".sidebar-toggle");
      const showSidebarButton = document.querySelector(".sidebar-restore");
      const themeButton = document.querySelector(".theme-toggle");
      const decreaseFontButton = document.querySelector(".font-decrease");
      const increaseFontButton = document.querySelector(".font-increase");
      const fontScaleOptions = [
        { key: "normal", label: "100%" },
        { key: "large", label: "115%" },
        { key: "larger", label: "130%" },
        { key: "largest", label: "145%" },
      ];

      function setTheme(theme) {
        document.documentElement.dataset.theme = theme;
        const nextTheme = theme === "dark" ? "light" : "dark";
        themeButton?.setAttribute("aria-label", `Activar modo ${nextTheme === "dark" ? "oscuro" : "claro"}`);
        const themeLabel = themeButton?.querySelector("small");
        if (themeLabel) themeLabel.textContent = theme === "dark" ? "Oscuro" : "Claro";
        localStorage.setItem("geoSuperior.theme", theme);
      }

      setTheme(document.documentElement.dataset.theme === "dark" ? "dark" : "light");
      themeButton?.addEventListener("click", () => {
        setTheme(document.documentElement.dataset.theme === "dark" ? "light" : "dark");
      });

      function setFontScale(scale) {
        const option = fontScaleOptions.find((item) => item.key === scale) ?? fontScaleOptions[0];
        document.documentElement.dataset.fontScale = option.key;
        const currentIndex = fontScaleOptions.indexOf(option);
        document.querySelectorAll(".font-toggle small").forEach((label) => {
          label.textContent = option.label;
        });
        if (decreaseFontButton instanceof HTMLButtonElement) {
          decreaseFontButton.disabled = currentIndex === 0;
        }
        if (increaseFontButton instanceof HTMLButtonElement) {
          increaseFontButton.disabled = currentIndex === fontScaleOptions.length - 1;
        }
        localStorage.setItem("geoSuperior.fontScale", option.key);
      }

      setFontScale(document.documentElement.dataset.fontScale ?? "normal");
      decreaseFontButton?.addEventListener("click", () => {
        const currentIndex = fontScaleOptions.findIndex((item) => item.key === document.documentElement.dataset.fontScale);
        const nextIndex = Math.max(0, currentIndex - 1);
        setFontScale(fontScaleOptions[nextIndex].key);
      });
      increaseFontButton?.addEventListener("click", () => {
        const currentIndex = fontScaleOptions.findIndex((item) => item.key === document.documentElement.dataset.fontScale);
        const nextIndex = Math.min(fontScaleOptions.length - 1, Math.max(0, currentIndex) + 1);
        setFontScale(fontScaleOptions[nextIndex].key);
      });

      function setSidebarCollapsed(collapsed) {
        shell?.classList.toggle("sidebar-collapsed", collapsed);
        hideSidebarButton?.setAttribute("aria-expanded", String(!collapsed));
        hideSidebarButton?.setAttribute("aria-label", collapsed ? "Mostrar panel lateral" : "Ocultar panel lateral");
        if (showSidebarButton) showSidebarButton.hidden = !collapsed;
        localStorage.setItem("geoSuperior.sidebarCollapsed", collapsed ? "1" : "0");
      }

      setSidebarCollapsed(localStorage.getItem("geoSuperior.sidebarCollapsed") === "1");
      hideSidebarButton?.addEventListener("click", () => {
        setSidebarCollapsed(!shell?.classList.contains("sidebar-collapsed"));
      });
      showSidebarButton?.addEventListener("click", () => setSidebarCollapsed(false));

      document.querySelectorAll(".nav-collapsible").forEach((section) => {
        const sectionName = section.dataset.navSection;
        const toggle = section.querySelector(".nav-section-toggle");
        const links = section.querySelector(".nav-section-links");
        if (!sectionName || !toggle || !links) return;

        const storageKey = `geoSuperior.sidebarSection.${sectionName}`;
        const savedState = localStorage.getItem(storageKey);
        const containsCurrentPage = Boolean(links.querySelector("a.active"));
        const initiallyCollapsed = savedState === "closed" && !containsCurrentPage;

        function setSectionCollapsed(collapsed) {
          section.classList.toggle("is-collapsed", collapsed);
          toggle.setAttribute("aria-expanded", String(!collapsed));
          links.hidden = collapsed;
          localStorage.setItem(storageKey, collapsed ? "closed" : "open");
        }

        setSectionCollapsed(initiallyCollapsed);
        toggle.addEventListener("click", () => {
          setSectionCollapsed(!section.classList.contains("is-collapsed"));
        });
      });

      document.querySelectorAll("details.proof").forEach((details) => {
        const summary = details.querySelector("summary");
        const body = details.querySelector(".proof-body");
        if (!summary || !body) return;

        if (details.open) body.style.height = "auto";
        else body.style.height = "0px";

        summary.addEventListener("click", (event) => {
          event.preventDefault();
          const isOpen = details.open;

          if (isOpen) {
            body.style.height = `${body.scrollHeight}px`;
            body.offsetHeight;
            body.style.height = "0px";
            details.classList.add("is-closing");
            window.setTimeout(() => {
              details.open = false;
              details.classList.remove("is-closing");
            }, 220);
            return;
          }

          details.open = true;
          body.style.height = "0px";
          body.offsetHeight;
          body.style.height = `${body.scrollHeight}px`;
          window.setTimeout(() => {
            body.style.height = "auto";
          }, 220);
        });
      });
    </script>
  </body>
</html>
