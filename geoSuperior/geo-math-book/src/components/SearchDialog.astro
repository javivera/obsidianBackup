---
import { searchCatalog } from "../data/searchCatalog";
---

<dialog class="search-dialog" id="search-dialog" aria-labelledby="search-dialog-title">
  <div class="search-dialog-panel">
    <header class="search-dialog-header">
      <div>
        <span>Buscar en {searchCatalog.length} entradas</span>
        <strong id="search-dialog-title">Teoremas y definiciones</strong>
      </div>
      <button class="search-dialog-close" type="button" aria-label="Cerrar busqueda">×</button>
    </header>

    <input
      class="search-input"
      id="floating-book-search"
      type="search"
      placeholder="Derivada exterior, flujo maximal, rango constante..."
      autocomplete="off"
    />
    <p class="search-status" id="floating-search-status" aria-live="polite">
      Empieza a escribir para buscar.
    </p>
    <div class="search-results search-dialog-results" id="floating-search-results"></div>
  </div>
</dialog>

<script is:inline define:vars={{ catalog: searchCatalog }}>
  const dialog = document.querySelector("#search-dialog");
  const openButton = document.querySelector("#search-dialog-open");
  const closeButton = dialog?.querySelector(".search-dialog-close");
  const searchInput = dialog?.querySelector("#floating-book-search");
  const searchStatus = dialog?.querySelector("#floating-search-status");
  const searchResults = dialog?.querySelector("#floating-search-results");

  function normalizeSearchValue(value) {
    return value
      .toLocaleLowerCase("es")
      .normalize("NFD")
      .replace(/[\u0300-\u036f]/g, "")
      .replace(/[^a-z0-9]+/g, " ")
      .trim();
  }

  function floatingFuzzyScore(query, value) {
    let queryIndex = 0;
    let firstMatch = -1;
    let lastMatch = -1;

    for (let index = 0; index < value.length && queryIndex < query.length; index += 1) {
      if (value[index] !== query[queryIndex]) continue;
      if (firstMatch === -1) firstMatch = index;
      lastMatch = index;
      queryIndex += 1;
    }

    if (queryIndex !== query.length) return -1;
    return Math.max(1, 45 - (lastMatch - firstMatch + 1) - firstMatch);
  }

  function floatingEntryScore(entry, query) {
    const title = normalizeSearchValue(entry.title);
    const text = normalizeSearchValue(entry.searchText);
    const words = query.split(" ").filter(Boolean);
    let score = 0;

    if (title === query) score += 500;
    if (title.startsWith(query)) score += 300;
    if (title.includes(query)) score += 220;
    if (text.includes(query)) score += 100;

    const matchedWords = words.filter((word) => text.includes(word)).length;
    score += matchedWords * 45;
    if (matchedWords === words.length) score += 80;

    return score || floatingFuzzyScore(query.replaceAll(" ", ""), title.replaceAll(" ", ""));
  }

  function renderFloatingResults() {
    const query = normalizeSearchValue(searchInput.value);
    searchResults.replaceChildren();

    if (!query) {
      searchStatus.textContent = "Empieza a escribir para buscar.";
      return;
    }

    const matches = catalog
      .map((entry) => ({ entry, score: floatingEntryScore(entry, query) }))
      .filter((match) => match.score > 0)
      .sort((a, b) => b.score - a.score || a.entry.title.localeCompare(b.entry.title))
      .slice(0, 30);

    searchStatus.textContent = matches.length
      ? `${matches.length} resultados mostrados.`
      : "No se encontraron resultados.";

    matches.forEach(({ entry }) => {
      const link = document.createElement("a");
      link.className = "search-result";
      link.href = `${entry.chapterHref}?block=${entry.index}`;

      const meta = document.createElement("div");
      meta.className = "search-result-meta";

      const kind = document.createElement("span");
      kind.textContent = entry.kindLabel;

      const chapter = document.createElement("small");
      chapter.textContent = `${entry.chapterLabel}: ${entry.chapterTitle}`;
      meta.append(kind, chapter);

      const title = document.createElement("strong");
      title.textContent = entry.title;

      const preview = document.createElement("p");
      preview.textContent = entry.preview || "Abrir la entrada en el capitulo.";

      link.append(meta, title, preview);
      searchResults.append(link);
    });
  }

  openButton?.addEventListener("click", () => {
    dialog.showModal();
    window.requestAnimationFrame(() => searchInput.focus());
  });
  closeButton?.addEventListener("click", () => dialog.close());
  dialog?.addEventListener("click", (event) => {
    if (event.target === dialog) dialog.close();
  });
  dialog?.addEventListener("keydown", (event) => {
    if (event.key !== "Escape") return;
    event.preventDefault();
    dialog.close();
  });
  searchInput?.addEventListener("input", renderFloatingResults);
</script>
