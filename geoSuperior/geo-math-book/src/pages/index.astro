---
import BookLayout from "../layouts/BookLayout.astro";
import { chapters } from "../data/chapters";
import { withBase } from "../lib/paths";

const theoryChapters = chapters.filter((chapter) => chapter.section === "theory");
const practiceChapters = chapters.filter((chapter) => chapter.section === "practice");
---

<BookLayout title="Inicio" description="Libro interactivo de geometria superior">
  <h1>Geo Superior</h1>
  <p class="lede">
    Un primer prototipo de libro interactivo para apuntes de geometria superior:
    contenido matematico en MDX, bloques semanticos y referencias con vista previa al pasar el cursor.
  </p>

  <p>
    <a class="study-link" href={withBase("/random")}>
      Practicar con una definicion, teorema o demostracion al azar
    </a>
  </p>

  <h2>Teoria</h2>
  <ul>
    {theoryChapters.map((chapter) => (
      <li>
        <a href={chapter.href}>{chapter.label}: {chapter.title}</a>
      </li>
    ))}
  </ul>

  <h2>Practica</h2>
  <ul>
    {practiceChapters.map((chapter) => (
      <li>
        <a href={chapter.href}>{chapter.label}: {chapter.title}</a>
      </li>
    ))}
  </ul>
</BookLayout>
