---
import "katex/dist/katex.min.css";
import BookLayout from "../layouts/BookLayout.astro";
import { corazonTheorems } from "../data/corazonTheorems";

const theoremCount = corazonTheorems.length;
---

<BookLayout
  title="Teoremas corazon"
  description="Nota con todos los enunciados corazon y guias breves de reconstruccion"
  chapter="Corazones"
>
  <h1>Teoremas corazon</h1>
  <p class="lede">
    Todos los enunciados marcados con corazon, con guia de reconstruccion y prueba completa.
  </p>

  <ol class="corazon-note-index" aria-label="Indice de teoremas corazon">
    {corazonTheorems.map((theorem, index) => (
      <li>
        <a href={`#corazon-${index + 1}`}>
          <span>{index + 1}. {theorem.chapterLabel}</span>
          <small set:html={theorem.titleHtml || theorem.kindLabel} />
        </a>
      </li>
    ))}
  </ol>

  <section class="corazon-note-list" aria-label={`${theoremCount} enunciados corazon`}>
    {corazonTheorems.map((theorem, index) => (
      <article class={`book-block ${theorem.kind} corazon-note-item`} id={`corazon-${index + 1}`}>
        <header>
          <span class="eyebrow">{theorem.kindLabel} {index + 1}</span>
          <strong set:html={theorem.titleHtml || theorem.chapterLabel} />
          <a class="source-file" href={`${theorem.chapterHref}?block=${theorem.blockIndex}`}>
            Enunciado original: {theorem.sourceFile}
          </a>
        </header>
        <div class="block-body" set:html={theorem.statementHtml} />

        <details class="memory-proof lazy-proof" aria-label="Guia breve para reconstruir la demostracion">
          <summary>Guia de reconstruccion</summary>
          <div class="memory-proof-content" aria-live="polite"></div>
          <template>
            {theorem.proofCueStepsHtml.length > 0 ? (
              <ol>
                {theorem.proofCueStepsHtml.map((step) => (
                  <li set:html={step} />
                ))}
              </ol>
            ) : (
              <p class="memory-proof-empty">No hay demostracion cargada para resumir.</p>
            )}
          </template>
        </details>

        <section class="memory-proof full-proof lazy-step-proof" aria-label="Demostracion completa">
          <button class="proof-step-button proof-start-button" type="button">Mostrar prueba paso a paso</button>
          <div class="memory-proof-content" aria-live="polite"></div>
          <template>
            {theorem.proofStepsHtml.length > 0 ? (
              <ol>
                {theorem.proofStepsHtml.map((step) => (
                  <li set:html={step} />
                ))}
              </ol>
            ) : (
              <p class="memory-proof-empty">No hay demostracion cargada.</p>
            )}
          </template>
        </section>
      </article>
    ))}
  </section>

  <script>
    function prepareStepReveal(
      content: HTMLElement,
      button?: HTMLButtonElement,
      collapse?: () => void
    ) {
      const steps = Array.from(content.querySelectorAll("ol > li")).filter(
        (step): step is HTMLLIElement => step instanceof HTMLLIElement
      );
      if (steps.length === 0) {
        if (button) {
          button.textContent = "Sin pasos disponibles";
          button.disabled = true;
        }
        return;
      }

      let visibleSteps = 0;
      steps.forEach((step) => {
        step.hidden = true;
      });

      const revealButton = button ?? document.createElement("button");
      revealButton.className = "proof-step-button";
      revealButton.type = "button";

      const updateButton = () => {
        if (visibleSteps >= steps.length) {
          revealButton.textContent = "Ocultar pasos";
          revealButton.disabled = false;
          return;
        }

        revealButton.textContent =
          visibleSteps === 0
            ? `Mostrar primer paso (${steps.length})`
            : `Mostrar siguiente paso (${visibleSteps}/${steps.length})`;
        revealButton.disabled = false;
      };

      revealButton.addEventListener("click", () => {
        if (visibleSteps >= steps.length) {
          steps.forEach((step) => {
            step.hidden = true;
          });
          visibleSteps = 0;
          collapse?.();
          updateButton();
          return;
        }

        content.hidden = false;
        steps[visibleSteps].hidden = false;
        visibleSteps += 1;
        updateButton();
      });

      updateButton();
      if (!button) {
        content.append(revealButton);
      }
    }

    document.querySelectorAll(".lazy-proof").forEach((details) => {
      if (!(details instanceof HTMLDetailsElement)) return;

      details.addEventListener("toggle", () => {
        if (!details.open || details.dataset.loaded === "true") return;

        const content = details.querySelector(".memory-proof-content");
        const template = details.querySelector("template");
        if (!(content instanceof HTMLElement) || !(template instanceof HTMLTemplateElement)) return;

        content.textContent = "Cargando...";
        details.dataset.loaded = "true";

        window.setTimeout(() => {
          content.replaceChildren(template.content.cloneNode(true));
        }, 0);
      });
    });

    document.querySelectorAll(".lazy-step-proof").forEach((section) => {
      if (!(section instanceof HTMLElement)) return;

      const button = section.querySelector(".proof-start-button");
      const content = section.querySelector(".memory-proof-content");
      const template = section.querySelector("template");
      if (
        !(button instanceof HTMLButtonElement) ||
        !(content instanceof HTMLElement) ||
        !(template instanceof HTMLTemplateElement)
      ) {
        return;
      }

      button.addEventListener("click", () => {
        if (section.dataset.loaded === "true") return;

        content.textContent = "Cargando...";
        section.dataset.loaded = "true";

        window.setTimeout(() => {
          content.replaceChildren(template.content.cloneNode(true));
          prepareStepReveal(content, button, () => {
            content.hidden = true;
            button.textContent = "Mostrar prueba paso a paso";
          });
          button.click();
        }, 0);
      });
    });
  </script>
</BookLayout>

<style>
  .corazon-note-index {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(210px, 1fr));
    gap: 8px;
    margin: 28px 0;
    padding: 0;
    list-style: none;
  }

  .corazon-note-index a {
    display: grid;
    gap: 4px;
    min-height: 74px;
    padding: 10px 12px;
    border: 1px solid var(--line);
    border-radius: 7px;
    color: var(--ink);
    text-decoration: none;
  }

  .corazon-note-index a:hover {
    background: var(--hover);
  }

  .corazon-note-index span,
  .corazon-note-index small {
    overflow-wrap: anywhere;
  }

  .corazon-note-index span {
    font-weight: 800;
  }

  .corazon-note-index small {
    color: var(--muted);
    line-height: 1.35;
  }

  .corazon-note-list {
    display: grid;
    gap: 28px;
  }

  .corazon-note-item {
    scroll-margin-top: 120px;
  }

  .source-file {
    display: block;
    margin-top: 6px;
    color: var(--muted);
    font-size: 13px;
    font-weight: 650;
  }

  .memory-proof {
    margin-top: 18px;
    padding-top: 16px;
    border-top: 1px solid var(--line);
  }

  .memory-proof + .memory-proof {
    margin-top: 12px;
  }

  .memory-proof summary {
    display: flex;
    gap: 12px;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 10px;
    cursor: pointer;
    font-size: 17px;
    font-weight: 800;
  }

  .memory-proof summary:hover {
    color: var(--accent);
  }

  .memory-proof-content {
    min-height: 1lh;
  }

  .memory-proof ol {
    display: grid;
    gap: 8px;
    margin: 0;
    padding-left: 24px;
  }

  .memory-proof li {
    padding-left: 4px;
  }

  .memory-proof li p {
    margin: 0;
  }

  .memory-proof li > :first-child {
    margin-top: 0;
  }

  .memory-proof li > :last-child {
    margin-bottom: 0;
  }

  .proof-step-button {
    margin-top: 12px;
    padding: 9px 12px;
    border: 1px solid var(--line);
    border-radius: 7px;
    background: var(--paper);
    color: var(--ink);
    cursor: pointer;
    font: inherit;
    font-size: 14px;
    font-weight: 750;
  }

  .proof-step-button:hover:not(:disabled) {
    background: var(--hover);
  }

  .proof-step-button:disabled {
    cursor: default;
    color: var(--muted);
  }

  .memory-proof-empty {
    margin: 0;
    color: var(--muted);
  }
</style>
