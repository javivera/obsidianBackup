---
import BookLayout from "../layouts/BookLayout.astro";
import { searchCatalog as catalog } from "../data/searchCatalog";
---

<BookLayout
  title="Buscar"
  description="Busqueda difusa de definiciones, teoremas y otros resultados"
  chapter="Buscar"
>
  <div class="search-page">
    <header class="random-hero">
      <p class="random-kicker">Indice del libro</p>
      <h1>Buscar</h1>
      <p class="lede">
        Escribe el nombre, una palabra aproximada o parte del enunciado de una
        definicion, teorema, lema o proposicion.
      </p>
    </header>

    <label class="search-label" for="book-search">Buscar en {catalog.length} entradas</label>
    <input
      class="search-input"
      id="book-search"
      type="search"
      placeholder="Ejemplo: derivada exterior, flujo maximal, rango constante..."
      autocomplete="off"
      autofocus
    />

    <p class="search-status" id="search-status" aria-live="polite">
      Empieza a escribir para buscar.
    </p>
    <div class="search-results" id="search-results"></div>
  </div>

  <script is:inline define:vars={{ catalog }}>
    const searchInput = document.querySelector("#book-search");
    const searchStatus = document.querySelector("#search-status");
    const searchResults = document.querySelector("#search-results");

    function normalize(value) {
      return value
        .toLocaleLowerCase("es")
        .normalize("NFD")
        .replace(/[\u0300-\u036f]/g, "")
        .replace(/[^a-z0-9]+/g, " ")
        .trim();
    }

    function fuzzySequenceScore(query, value) {
      let queryIndex = 0;
      let firstMatch = -1;
      let lastMatch = -1;

      for (let index = 0; index < value.length && queryIndex < query.length; index += 1) {
        if (value[index] !== query[queryIndex]) continue;
        if (firstMatch === -1) firstMatch = index;
        lastMatch = index;
        queryIndex += 1;
      }

      if (queryIndex !== query.length) return -1;
      const span = lastMatch - firstMatch + 1;
      return Math.max(1, 45 - span - firstMatch);
    }

    function scoreEntry(entry, query) {
      const title = normalize(entry.title);
      const text = normalize(entry.searchText);
      const words = query.split(" ").filter(Boolean);
      let score = 0;

      if (title === query) score += 500;
      if (title.startsWith(query)) score += 300;
      if (title.includes(query)) score += 220;
      if (text.includes(query)) score += 100;

      const matchedWords = words.filter((word) => text.includes(word)).length;
      score += matchedWords * 45;
      if (matchedWords === words.length) score += 80;

      if (score === 0) {
        score = fuzzySequenceScore(query.replaceAll(" ", ""), title.replaceAll(" ", ""));
      }

      return score;
    }

    function renderResults() {
      const query = normalize(searchInput.value);
      searchResults.replaceChildren();

      if (!query) {
        searchStatus.textContent = "Empieza a escribir para buscar.";
        return;
      }

      const matches = catalog
        .map((entry) => ({ entry, score: scoreEntry(entry, query) }))
        .filter((match) => match.score > 0)
        .sort((a, b) => b.score - a.score || a.entry.title.localeCompare(b.entry.title))
        .slice(0, 30);

      searchStatus.textContent = matches.length
        ? `${matches.length} resultados mostrados.`
        : "No se encontraron resultados.";

      matches.forEach(({ entry }) => {
        const link = document.createElement("a");
        link.className = "search-result";
        link.href = `${entry.chapterHref}?block=${entry.index}`;

        const meta = document.createElement("div");
        meta.className = "search-result-meta";

        const kind = document.createElement("span");
        kind.textContent = entry.kindLabel;

        const chapter = document.createElement("small");
        chapter.textContent = `${entry.chapterLabel}: ${entry.chapterTitle}`;
        meta.append(kind, chapter);

        const title = document.createElement("strong");
        title.textContent = entry.title;

        const preview = document.createElement("p");
        preview.textContent = entry.preview || "Abrir la entrada en el capitulo.";

        link.append(meta, title, preview);
        searchResults.append(link);
      });
    }

    searchInput.addEventListener("input", renderResults);
  </script>
</BookLayout>
