---
import "katex/dist/katex.min.css";
import BookLayout from "../layouts/BookLayout.astro";
import { corazonTheorems } from "../data/corazonTheorems";

const theoremDeck = corazonTheorems;
---

<BookLayout
  title="Evaluador corazon"
  description="Evaluador de teoremas corazon"
  chapter="Corazon"
>
  <h1>Evaluador corazon</h1>
  <p class="lede">Repaso activo de los enunciados marcados con corazon.</p>

  <section class="corazon-study-grid">
    <div class="corazon-study-main">
      <section id="theorem-block" class="book-block theorem">
        <header>
          <span class="eyebrow" id="kind-label">Teorema</span>
          <strong id="theorem-title"></strong>
        </header>
        <div class="block-body" id="theorem-statement"></div>
      </section>

      <div class="corazon-actions">
        <button class="primary-button" id="proof-button" type="button">Mostrar demostracion paso a paso</button>
        <button id="know-button" type="button">Lo se</button>
        <button id="miss-button" type="button">No lo se</button>
        <button id="skip-button" type="button">Otro teorema</button>
      </div>

      <section class="proof-reveal" id="proof-panel" hidden>
        <div class="proof-reveal-header">
          <div>
            <span class="proof-label">Demostracion</span>
            <small id="proof-count">Paso 0/0</small>
          </div>
          <button class="secondary-button" id="next-step-button" type="button">Siguiente paso</button>
        </div>
        <div class="proof-steps" id="proof-steps"></div>
      </section>
    </div>

    <aside class="corazon-score-panel">
      <div class="corazon-score-head">
        <h2>Evaluados</h2>
        <strong id="overall-score">0%</strong>
      </div>
      <div class="corazon-score-list" id="score-list">
        <p>Todavia no evaluaste ningun teorema.</p>
      </div>
    </aside>
  </section>

  <script is:inline define:vars={{ theoremDeck }}>
    const STORAGE_KEY = "geo-math-book:corazon-evaluation:v3";
    const deck = theoremDeck;

    const theoremBlock = document.querySelector("#theorem-block");
    const kindLabel = document.querySelector("#kind-label");
    const theoremTitle = document.querySelector("#theorem-title");
    const theoremStatement = document.querySelector("#theorem-statement");
    const proofButton = document.querySelector("#proof-button");
    const knowButton = document.querySelector("#know-button");
    const missButton = document.querySelector("#miss-button");
    const skipButton = document.querySelector("#skip-button");
    const proofPanel = document.querySelector("#proof-panel");
    const proofCount = document.querySelector("#proof-count");
    const proofSteps = document.querySelector("#proof-steps");
    const nextStepButton = document.querySelector("#next-step-button");
    const scoreList = document.querySelector("#score-list");
    const overallScore = document.querySelector("#overall-score");

    let current = null;
    let proofIndex = -1;
    let lastId = "";

    function loadStats() {
      try {
        return JSON.parse(localStorage.getItem(STORAGE_KEY) || "{}");
      } catch {
        return {};
      }
    }

    function saveStats(stats) {
      localStorage.setItem(STORAGE_KEY, JSON.stringify(stats));
    }

    function percent(hit, total) {
      return total ? Math.round((hit / total) * 100) : 0;
    }

    function pickRandom() {
      if (!deck.length) return null;
      if (deck.length === 1) return deck[0];
      let next = deck[Math.floor(Math.random() * deck.length)];
      while (next.id === lastId) next = deck[Math.floor(Math.random() * deck.length)];
      lastId = next.id;
      return next;
    }

    function renderScores() {
      const stats = loadStats();
      const evaluated = deck
        .map((theorem) => ({ theorem, stat: stats[theorem.id] }))
        .filter((item) => item.stat?.total)
        .sort((a, b) => percent(b.stat.hit, b.stat.total) - percent(a.stat.hit, a.stat.total));

      const totals = evaluated.reduce(
        (acc, item) => {
          acc.hit += item.stat.hit;
          acc.total += item.stat.total;
          return acc;
        },
        { hit: 0, total: 0 }
      );

      overallScore.textContent = `${percent(totals.hit, totals.total)}%`;

      if (!evaluated.length) {
        scoreList.innerHTML = "<p>Todavia no evaluaste ningun teorema.</p>";
        return;
      }

      scoreList.innerHTML = evaluated
        .map(({ theorem, stat }) => {
          const score = percent(stat.hit, stat.total);
          return `
            <div class="corazon-score-item">
              <button class="corazon-score-select" type="button" data-theorem-id="${theorem.id}">
                <span>
                  <strong>${theorem.chapterLabel}</strong>
                  <span>${theorem.titleHtml || theorem.kindLabel}</span>
                  <small>${stat.hit}/${stat.total} correctas</small>
                </span>
                <b>${score}%</b>
              </button>
              <button class="corazon-score-delete" type="button" data-theorem-id="${theorem.id}" aria-label="Borrar resultado de ${theorem.chapterLabel}">
                Borrar
              </button>
            </div>
          `;
        })
        .join("");
    }

    function theoremById(id) {
      return deck.find((theorem) => theorem.id === id);
    }

    function selectTheorem(id) {
      const theorem = theoremById(id);
      if (!theorem) return;
      lastId = theorem.id;
      renderTheorem(theorem);
      theoremBlock.scrollIntoView({ behavior: "smooth", block: "start" });
    }

    function deleteScore(id) {
      if (!id) return;
      const stats = loadStats();
      delete stats[id];
      saveStats(stats);
      renderScores();
    }

    function renderTheorem(theorem) {
      current = theorem;
      proofIndex = -1;
      proofPanel.hidden = true;
      proofSteps.innerHTML = "";
      theoremBlock.className = `book-block ${theorem.kind}`;
      kindLabel.textContent = theorem.kindLabel;
      theoremTitle.innerHTML = theorem.titleHtml;
      theoremTitle.hidden = theorem.titleHtml.trim() === "";
      theoremStatement.innerHTML = theorem.statementHtml;
      proofButton.disabled = theorem.proofStepsHtml.length === 0;
      proofButton.textContent = theorem.proofStepsHtml.length
        ? "Mostrar demostracion paso a paso"
        : "Sin demostracion cargada";
      nextStepButton.disabled = true;
      proofCount.textContent = "Paso 0/0";
    }

    function nextTheorem() {
      const theorem = pickRandom();
      if (theorem) renderTheorem(theorem);
    }

    function showNextProofStep() {
      if (!current?.proofStepsHtml.length) return;
      proofPanel.hidden = false;
      proofIndex = Math.min(proofIndex + 1, current.proofStepsHtml.length - 1);
      const step = document.createElement("div");
      step.className = "proof-step";
      step.innerHTML = current.proofStepsHtml[proofIndex];
      proofSteps.append(step);
      proofCount.textContent = `Paso ${proofIndex + 1}/${current.proofStepsHtml.length}`;
      nextStepButton.disabled = proofIndex >= current.proofStepsHtml.length - 1;
    }

    function record(knows) {
      if (!current) return;
      const stats = loadStats();
      const previous = stats[current.id] || { hit: 0, total: 0 };
      stats[current.id] = {
        hit: previous.hit + (knows ? 1 : 0),
        total: previous.total + 1,
        updatedAt: Date.now()
      };
      saveStats(stats);
      renderScores();
      nextTheorem();
    }

    proofButton.addEventListener("click", showNextProofStep);
    nextStepButton.addEventListener("click", showNextProofStep);
    knowButton.addEventListener("click", () => record(true));
    missButton.addEventListener("click", () => record(false));
    skipButton.addEventListener("click", nextTheorem);
    scoreList.addEventListener("click", (event) => {
      const deleteButton = event.target.closest(".corazon-score-delete");
      if (deleteButton) {
        deleteScore(deleteButton.dataset.theoremId);
        return;
      }

      const selectButton = event.target.closest(".corazon-score-select");
      if (selectButton) selectTheorem(selectButton.dataset.theoremId);
    });

    renderScores();
    nextTheorem();
  </script>
</BookLayout>

<style>
  .corazon-study-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(240px, 300px);
    gap: 24px;
    align-items: start;
  }

  .corazon-study-main {
    min-width: 0;
  }

  .corazon-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    align-items: center;
  }

  .corazon-actions button,
  .proof-reveal button {
    min-height: 36px;
    padding: 7px 12px;
    border: 1px solid var(--line);
    border-radius: 7px;
    background: var(--paper);
    color: var(--ink);
    font: inherit;
    font-weight: 700;
    text-decoration: none;
    cursor: pointer;
  }

  .corazon-actions button:hover,
  .proof-reveal button:hover {
    background: var(--hover);
  }

  .corazon-actions .primary-button {
    background: var(--ink);
    border-color: var(--ink);
    color: var(--paper);
  }

  .corazon-actions .primary-button:hover {
    background: var(--button-hover);
  }

  .corazon-actions button:disabled,
  .proof-reveal button:disabled {
    cursor: not-allowed;
    opacity: 0.55;
  }

  .corazon-score-panel {
    position: sticky;
    top: 24px;
    padding: 18px;
    border: 1px solid var(--line);
    background: var(--paper);
  }

  .corazon-score-head {
    display: flex;
    gap: 14px;
    align-items: baseline;
    justify-content: space-between;
    padding-bottom: 12px;
    border-bottom: 1px solid var(--line);
  }

  .corazon-score-head h2 {
    margin: 0;
    font-size: 18px;
  }

  .corazon-score-list {
    display: grid;
    gap: 12px;
    margin-top: 14px;
  }

  .corazon-score-list p {
    margin: 0;
    color: var(--muted);
  }

  .corazon-score-item {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 8px;
    align-items: start;
    padding-top: 12px;
    border-top: 1px solid var(--line);
  }

  .corazon-score-item:first-child {
    padding-top: 0;
    border-top: 0;
  }

  .corazon-score-select,
  .corazon-score-delete {
    border: 1px solid transparent;
    border-radius: 7px;
    background: transparent;
    color: var(--ink);
    font: inherit;
    cursor: pointer;
  }

  .corazon-score-select {
    display: flex;
    gap: 10px;
    justify-content: space-between;
    min-width: 0;
    padding: 6px;
    text-align: left;
  }

  .corazon-score-select:hover,
  .corazon-score-select:focus-visible {
    border-color: var(--line);
    background: var(--hover);
  }

  .corazon-score-delete {
    padding: 6px 8px;
    color: var(--muted);
    font-size: 12px;
    font-weight: 700;
  }

  .corazon-score-delete:hover,
  .corazon-score-delete:focus-visible {
    border-color: var(--line);
    background: var(--hover);
    color: var(--ink);
  }

  .corazon-score-select strong,
  .corazon-score-select span,
  .corazon-score-select small {
    display: block;
  }

  .corazon-score-select span {
    margin-top: 3px;
    line-height: 1.3;
  }

  .corazon-score-select small {
    margin-top: 4px;
    color: var(--muted);
  }

  .corazon-score-select b {
    white-space: nowrap;
  }

  @media (max-width: 980px) {
    .corazon-study-grid {
      grid-template-columns: 1fr;
    }

    .corazon-score-panel {
      position: static;
    }
  }
</style>
